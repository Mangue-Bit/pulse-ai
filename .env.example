# Chave da API da Groq (https://console.groq.com/keys). Copie este arquivo para .env
# e preencha a chave lá: o .env não é versionado. Nunca escreva a chave neste arquivo.
# Sem chave, o Pulse usa o cliente de modelo simulado.
GROQ_API_KEY=

# Modelo principal (pontos de chamada 1 a 5) e modelo do verificador (ponto 6).
# Os dois precisam aceitar saída estruturada em modo estrito na Groq.
PULSE_MODELO=openai/gpt-oss-120b
PULSE_MODELO_VERIFICADOR=openai/gpt-oss-120b

# Caminho do arquivo SQLite, relativo à raiz do repositório.
PULSE_BANCO=backend/dados/pulse.db

# Defina como 1 para forçar o cliente de modelo simulado mesmo com chave.
PULSE_MODELO_SIMULADO=